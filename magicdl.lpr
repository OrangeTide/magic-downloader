program magicdl;

{** Magic Downloader: index and sync your purchased collections.

  Console entry point. Parses arguments, builds the shared services, selects a
  backend by name, and runs the requested command.

  PUBLIC DOMAIN (CC0-1.0) }

{$mode objfpc}{$H+}

uses
  {$IFDEF UNIX}cwstring, termio,{$ENDIF}  { cwstring: UTF-8 default codepage
    from the locale, so Unicode paths are stored and read unchanged (no
    single-byte transcode). termio: turn off echo while reading a key. }
  Classes, SysUtils, contnrs, fpjson, DateUtils,
  mdtypes, mdlog, mdpacing, mdhttp, mdindex, mdhash, mdbackend, mdcookies,
  mdconfig, mdkeyring,
  mdbackend_bandcamp,      { registers the bandcamp backend }
  mdbackend_drivethrurpg,  { registers the drivethrurpg backend }
  mdbackend_itchio;        { registers the itchio backend }

const
  { Generated by the Makefile from version.mk and the git state. }
  APP_VERSION = {$I version.inc};

type
  {** The shared services a command needs, built once and freed together. }
  TSession = record
    cookies: TCookieJar;
    pacer: TPacer;
    http: TMagicHttp;
    index: TMagicIndex;
  end;

var
  gLog: TMagicLogger;
  gConfig: TMagicConfig;

{ ---- Argument handling ---- }

{** Returns the value following --name on the command line, or a default. }
function ArgValue(const name, default: string): string;
var
  i: LongInt;
begin
  for i := 1 to ParamCount - 1 do
    if ParamStr(i) = name then begin
      ArgValue := ParamStr(i + 1);
      exit;
    end;
  ArgValue := default;
end;

function HasFlag(const name: string): boolean;
var
  i: LongInt;
begin
  for i := 1 to ParamCount do
    if ParamStr(i) = name then begin
      HasFlag := true;
      exit;
    end;
  HasFlag := false;
end;

{** Returns the positional arguments after the command word: everything that is
  not an option (--x) and not the value consumed by a value-taking option named
  in valueOpts. }
function Positionals(const valueOpts: array of string): TStringArray;
var
  i, j: LongInt;
  arg: string;
  isValueOpt: boolean;
begin
  Positionals := nil;
  i := 2;  { skip program name (0) and command (1) }
  while i <= ParamCount do begin
    arg := ParamStr(i);
    if Copy(arg, 1, 2) = '--' then begin
      isValueOpt := false;
      for j := 0 to High(valueOpts) do
        if arg = valueOpts[j] then begin
          isValueOpt := true;
          break;
        end;
      if isValueOpt then
        Inc(i);  { also skip its value }
    end
    else begin
      SetLength(Result, Length(Result) + 1);
      Result[High(Result)] := arg;
    end;
    Inc(i);
  end;
end;

procedure PrintUsage;
var
  names: TStringArray;
  i: LongInt;
begin
  Writeln('Magic Downloader ', APP_VERSION);
  Writeln;
  Writeln('Usage: magicdl <command> [options]');
  Writeln;
  Writeln('Commands:');
  Writeln('  list-backends              List available backends');
  Writeln('  scopes                     List a backend''s --scope refs (itchio: bundles)');
  Writeln('  index                      Index a collection (no downloads)');
  Writeln('  sync [<id>...]             Download items: full listing, given ids,');
  Writeln('                             or --from-index to use the stored index');
  Writeln('  verify                     Check downloaded files, relocate moved ones');
  Writeln('  check [<id>...]            Compare local copies to the store''s current');
  Writeln('                             version by hash (outdated/current/...)');
  Writeln('  status                     Show a summary of the collection state');
  Writeln('  list                       List items, with filters (see below)');
  Writeln('  details <id>               Show one item''s versions and files');
  Writeln('  blacklist <id>...          Mark items so sync skips them');
  Writeln('  allow <id>...              Remove items from the blacklist');
  Writeln('  relocate <old> <new>       Record that an item moved to a new id');
  Writeln('  forget <id>...             Clear the adopted mark so sync fetches again');
  Writeln('  reorganize <dir>           Fold loose files into <user>.itch.io/<slug>');
  Writeln('                             folders (itchio; single-owner hosts)');
  Writeln('  import <dir>               Mark items already in an Artist/Album library');
  Writeln('  manifest                   Write a library manifest (Markdown or --html)');
  Writeln('                             with download checkboxes (filters apply)');
  Writeln('  key set|get|rm             Store, show, or remove a backend key in the');
  Writeln('                             system keyring (--backend, optional --user)');
  Writeln;
  Writeln('Options:');
  Writeln('  --backend <name>           Backend to use');
  Writeln('  --user <name>              Account name: the bandcamp fan handle, or');
  Writeln('                             which keyring account to use (see key)');
  Writeln('  --scope <ref>              Index/sync only a subset (itchio: a bundle');
  Writeln('                             link, id, or title; see the scopes command)');
  Writeln('  --refresh                  Ignore the cached --scope result and re-fetch');
  Writeln('  --app-key <key>            Application key (drivethrurpg); prefer the keyring');
  Writeln('  --app-key-file <path>      Read the application key from a file (not the CLI)');
  Writeln('  --cookies <path>           Cookies file (SQLite, Cookie Quick');
  Writeln('                             Manager JSON, or Netscape cookies.txt)');
  Writeln('  --firefox                  Load cookies from Firefox profiles');
  Writeln('  --db <path>                Index database (default: standard data');
  Writeln('                             dir, or config [general] db)');
  Writeln('  --out <dir>                Output directory (required; or config out)');
  Writeln('  --format <list>            Content formats, comma-separated. Bandcamp');
  Writeln('                             requests the first (flac, vorbis=ogg, mp3-320,');
  Writeln('                             ...); multi-file backends keep only these');
  Writeln('                             types (e.g. pdf,epub). Unset: flac / all');
  Writeln('  --covers                   Also download cover images (sync)');
  Writeln('  --from-index               Sync from the stored index, no API listing');
  Writeln('  --rehash                   Re-hash present files to check integrity (verify)');
  Writeln('  --rescan                   Relocate moved files by content hash (verify)');
  Writeln('  --reason <text>            Note why an item is blacklisted');
  Writeln('  --status <s>               Filter list by status (active/removed/...)');
  Writeln('  --hidden                   List filter: only hidden items');
  Writeln('  --blacklisted              List filter: only blacklisted items');
  Writeln('  --superseded               List filter: only relocated items');
  Writeln('  --downloaded               List filter: only downloaded items');
  Writeln('  --not-downloaded           List filter: only not-yet-downloaded items');
  Writeln('  --limit <n>                Cap the number of items listed');
  Writeln('  --out-file <path>          Write manifest here instead of stdout');
  Writeln('  --html                     Manifest as HTML (default: Markdown)');
  Writeln('  --no-check                 Manifest without download checkboxes');
  Writeln('  --json                     Machine-readable output (status/list/details/');
  Writeln('                             verify/blacklist/allow/relocate)');
  Writeln(Format('  --interval-ms <n>          Base delay between requests (default %d)',
    [DEFAULT_REQUEST_INTERVAL_MS]));
  Writeln('  --retries <n>              Retries per request (default 5)');
  Writeln('  --timeout-ms <n>           Per-request timeout (default 30000)');
  Writeln('  --skip-hidden              Skip hidden collection items');
  Writeln('  --dry-run                  Do not write files');
  Writeln('  --verbose                  Debug logging');
  Writeln;
  Writeln('Config file (optional): ',
    IncludeTrailingPathDelimiter(gConfig.ConfigDir), 'config.ini');
  Writeln('  [general] and [backend.<name>] sections set db, out, user,');
  Writeln('  app-key-file, cookies, format. Command-line options win.');
  Writeln;
  Writeln('Key resolution: --app-key, then --app-key-file or config app-key-file,');
  Writeln('  then the system keyring (magicdl key set), then config app-key.');
  Writeln;
  names := RegisteredBackendNames;
  Write('Registered backends:');
  for i := 0 to High(names) do
    Write(' ', names[i]);
  Writeln;
end;

{ ---- Context assembly ---- }

{** Reads an application key from a file, trimmed of surrounding whitespace, so
  the secret never appears on the command line. }
function ReadKeyFile(const path: string): string;
var
  sl: TStringList;
begin
  if not FileExists(path) then
    raise EMagicError.CreateFmt('Key file "%s" not found.', [path]);
  sl := TStringList.Create;
  try
    sl.LoadFromFile(path);
    ReadKeyFile := Trim(sl.Text);
  finally
    sl.Free;
  end;
end;

{** The index database path. Precedence: --db, then the config [general] db,
  then the standard data location. The parent directory is created if needed so
  a fresh install can open a new database. }
function ResolveDbPath: string;
begin
  Result := ArgValue('--db', '');
  if Result = '' then
    Result := gConfig.Get('', 'db', '');
  if Result = '' then
    Result := IncludeTrailingPathDelimiter(gConfig.DataDir) + 'magicdl.sqlite';
  Result := ExpandPathVars(Result);
  ForceDirectories(ExtractFilePath(Result));
end;

{** The output directory, or '' when none is configured. Precedence: --out,
  then config out (backend section, then general). There is no built-in
  default. }
function OutDirOrEmpty(const backend: string): string;
begin
  Result := ArgValue('--out', '');
  if Result = '' then
    Result := gConfig.Get(backend, 'out', '');
  if Result <> '' then
    Result := ExpandPathVars(Result);
end;

{** The output directory, raising when none is set. Used by commands that must
  write or read files. }
function RequireOutDir(const backend: string): string;
begin
  Result := OutDirOrEmpty(backend);
  if Result = '' then
    raise EMagicError.Create('No output directory. Pass --out <dir>, or set ' +
      'out= in ' + IncludeTrailingPathDelimiter(gConfig.ConfigDir) +
      'config.ini.');
end;

{** The keyring account key for a backend and optional user. With no user it is
  just the backend name, so a single-account setup needs no --user; with a user
  it is "backend:user", keeping several accounts of one backend apart. }
function KeyringAccount(const backend, user: string): string;
begin
  if user = '' then
    KeyringAccount := backend
  else
    KeyringAccount := backend + ':' + user;
end;

function BuildContext(index: TMagicIndex; cookies: TCookieJar;
  http: TMagicHttp; const backendName: string): TMagicContext;
var
  keyFile: string;
begin
  Result := Default(TMagicContext);
  Result.log := gLog;
  Result.http := http;
  Result.cookies := cookies;
  Result.index := index;
  Result.user := ArgValue('--user', '');
  if Result.user = '' then
    Result.user := gConfig.Get(backendName, 'user', '');
  Result.apiKey := ArgValue('--app-key', '');
  { Key resolution, most explicit first:
      1. --app-key on the command line (discouraged: visible to other processes)
      2. a key file, from --app-key-file or the config app-key-file
      3. the system keyring (see `magicdl key set`)
      4. a bare app-key in the config file
    The keyring is tried before the plaintext config value so a stored secret
    is preferred to one written on disk. }
  if Result.apiKey = '' then begin
    keyFile := ArgValue('--app-key-file', '');
    if keyFile = '' then
      keyFile := gConfig.Get(backendName, 'app-key-file', '');
    if keyFile <> '' then
      Result.apiKey := ReadKeyFile(ExpandPathVars(keyFile))
    else if KeyringLookup(KeyringAccount(backendName, Result.user),
      Result.apiKey) then
      { found in the keyring }
    else
      Result.apiKey := gConfig.Get(backendName, 'app-key', '');
  end;
  { The output directory may be unset here; commands that download check it. }
  Result.outputDir := OutDirOrEmpty(backendName);
  { --format is a comma list. For a single-file backend (Bandcamp) the first
    token is the audio format to request; for multi-file backends the whole set
    filters which files to download. Unset means flac for Bandcamp and all files
    elsewhere. }
  if ArgValue('--format', '') <> '' then
    Result.formats := ArgValue('--format', '').Split([','])
  else if gConfig.Get(backendName, 'format', '') <> '' then
    Result.formats := gConfig.Get(backendName, 'format', '').Split([','])
  else
    Result.formats := nil;
  if Result.formats <> nil then
    Result.audioFormat := Trim(Result.formats[0])
  else
    Result.audioFormat := 'flac';
  Result.skipHidden := HasFlag('--skip-hidden');
  Result.dryRun := HasFlag('--dry-run');
end;

{ ---- Commands ---- }

{** Populates the jar from --cookies or --firefox, if either was given. A backend
  that needs cookies enforces their presence in its own Authenticate. }
procedure LoadCookies(backendClass: TMagicBackendClass; cookies: TCookieJar);
var
  cookiesPath: string;
  profiles: LongInt;
begin
  cookiesPath := ArgValue('--cookies', '');
  if cookiesPath = '' then
    cookiesPath := ExpandPathVars(
      gConfig.Get(ArgValue('--backend', ''), 'cookies', ''));
  if cookiesPath <> '' then begin
    LoadCookiesFromFile(cookiesPath, cookies, backendClass.CookieHost, gLog);
    gLog.Info(Format('Loaded %d cookies from %s.', [cookies.Count, cookiesPath]));
  end
  else if HasFlag('--firefox') then begin
    if backendClass.CookieHost = '' then
      raise EMagicError.Create(
        'This backend does not define a cookie host, so Firefox cookies ' +
        'cannot be selected for it.');
    profiles := LoadFirefoxCookies(cookies, backendClass.CookieHost, gLog);
    gLog.Info(Format('Loaded %d cookies from %d Firefox profile(s).',
      [cookies.Count, profiles]));
  end;
end;

procedure CmdListBackends;
var
  names: TStringArray;
  i: LongInt;
begin
  names := RegisteredBackendNames;
  for i := 0 to High(names) do
    Writeln(names[i]);
end;

{** Resolves the backend named by --backend, raising when it is unknown. }
function RequireBackend(out backendName: string): TMagicBackendClass;
begin
  backendName := ArgValue('--backend', '');
  RequireBackend := FindBackend(backendName);
  if RequireBackend = nil then
    raise EMagicError.CreateFmt('Unknown backend: "%s". Try list-backends.',
      [backendName]);
end;

{** Builds the shared services from the command-line options. }
function OpenSession: TSession;
begin
  Result.cookies := TCookieJar.Create;
  { CLI wins, then the config [general] section, then the built-in default. }
  Result.pacer := TPacer.Create(gLog,
    StrToInt64Def(ArgValue('--interval-ms', ''),
      StrToInt64Def(gConfig.Get('', 'interval-ms', ''),
        DEFAULT_REQUEST_INTERVAL_MS)));
  Result.http := TMagicHttp.Create(gLog, Result.pacer, Result.cookies,
    StrToIntDef(ArgValue('--retries', ''),
      StrToIntDef(gConfig.Get('', 'retries', ''), 5)),
    StrToIntDef(ArgValue('--timeout-ms', ''),
      StrToIntDef(gConfig.Get('', 'timeout-ms', ''), 30000)));
  Result.index := TMagicIndex.Create(ResolveDbPath);
end;

procedure CloseSession(var s: TSession);
begin
  s.index.Free;
  s.http.Free;
  s.pacer.Free;
  s.cookies.Free;
end;

{** Replaces characters that are invalid in a file name with look-alikes, and
  fixes a trailing dot or space (rejected on Windows). Ported from the reference
  project's replaceInvalidCharsByUnicode. }
function SanitizeName(const s: string): string;
const
  BAD  = ':/\"*<>?|';
  GOOD: array[1..9] of string =
    ('꞉', '／', '⧹', '＂', '⋆', '＜', '＞', '？', '∣');
var
  i, k: LongInt;
  c: char;
  ch: string;
begin
  Result := '';
  for i := 1 to Length(s) do begin
    c := s[i];
    k := Pos(c, BAD);
    if k > 0 then
      ch := GOOD[k]
    else
      ch := c;
    Result := Result + ch;
  end;
  if Result <> '' then begin
    if Result[Length(Result)] = '.' then
      Result := Copy(Result, 1, Length(Result) - 1) + '․'
    else if Result[Length(Result)] = ' ' then
      Result := Copy(Result, 1, Length(Result) - 1) + ' ';
  end;
end;

{** Lists the collection and folds it into the index: upserts every item under a
  single run timestamp, then sweeps anything not seen this run to removed. }
procedure IndexCollection(backend: TMagicBackend; index: TMagicIndex;
  const backendName: string; out items: TCollectionItemArray);
var
  seen: string;
  i: LongInt;
begin
  seen := NowIsoUtc;
  items := backend.ListCollection;
  for i := 0 to High(items) do
    index.UpsertItem(backendName, items[i], seen);
  index.SweepRemoved(backendName, seen);
  index.Commit;
end;

{** Resolving a scope can take many paced requests (an itch.io bundle lists its
  games, then owned-keys is queried in batches), so the result is cached on disk
  for this long and reused until --refresh or the age limit. }
const
  SCOPE_CACHE_TTL_SEC = 24 * 60 * 60;  { one day }

{** Path of the cache file for one backend and scope reference. The reference
  (often a URL) is hashed so the name is filesystem-safe and fixed length. }
function ScopeCacheFile(const backendName, scopeRef: string): string;
var
  h: TSha256;
  digest: TSha256Digest;
  dir, key: string;
begin
  h := TSha256.Create;
  try
    h.Init;
    if scopeRef <> '' then
      h.Update(scopeRef[1], Length(scopeRef));
    h.Final(digest);
    key := Copy(Sha256ToHex(digest), 1, 16);
  finally
    h.Free;
  end;
  dir := IncludeTrailingPathDelimiter(gConfig.DataDir) + 'cache';
  ForceDirectories(dir);
  ScopeCacheFile := IncludeTrailingPathDelimiter(dir) +
    Format('scope-%s-%s.json', [backendName, key]);
end;

{** Writes the resolved scope items to the cache file, stamped with the time. }
procedure WriteScopeCache(const backendName, scopeRef: string;
  const items: TCollectionItemArray);
var
  root: TJSONObject;
  arr: TJSONArray;
  o: TJSONObject;
  i: LongInt;
begin
  root := TJSONObject.Create;
  try
    root.Add('scope', scopeRef);
    root.Add('backend', backendName);
    root.Add('resolved_at_unix', Int64(DateTimeToUnix(Now)));
    arr := TJSONArray.Create;
    for i := 0 to High(items) do begin
      o := TJSONObject.Create;
      o.Add('id', items[i].id);
      o.Add('title', items[i].title);
      o.Add('artist', items[i].artist);
      o.Add('itemType', items[i].itemType);
      o.Add('pageUrl', items[i].pageUrl);
      o.Add('coverUrl', items[i].coverUrl);
      o.Add('releaseDate', items[i].releaseDate);
      o.Add('hidden', items[i].hidden);
      arr.Add(o);
    end;
    root.Add('items', arr);
    with TStringList.Create do
      try
        Text := root.FormatJSON;
        SaveToFile(ScopeCacheFile(backendName, scopeRef));
      finally
        Free;
      end;
  finally
    root.Free;
  end;
end;

{** Loads cached scope items into items, returning the cache age in seconds, or
  -1 when there is no usable, unexpired cache. }
function ReadScopeCache(const backendName, scopeRef: string;
  out items: TCollectionItemArray): LongInt;
var
  path, raw: string;
  data: TJSONData;
  root, o: TJSONObject;
  arr: TJSONArray;
  i, age: LongInt;
  sl: TStringList;
begin
  items := nil;
  Result := -1;
  path := ScopeCacheFile(backendName, scopeRef);
  if not FileExists(path) then
    exit;
  sl := TStringList.Create;
  try
    sl.LoadFromFile(path);
    raw := sl.Text;
  finally
    sl.Free;
  end;
  try
    data := GetJSON(raw);
  except
    exit;  { corrupt cache: ignore it }
  end;
  try
    if not (data is TJSONObject) then
      exit;
    root := TJSONObject(data);
    age := LongInt(Int64(DateTimeToUnix(Now)) -
      root.Get('resolved_at_unix', Int64(0)));
    if (age < 0) or (age > SCOPE_CACHE_TTL_SEC) then
      exit;  { expired }
    if not (root.Find('items') is TJSONArray) then
      exit;
    arr := TJSONArray(root.Find('items'));
    SetLength(items, arr.Count);
    for i := 0 to arr.Count - 1 do begin
      items[i] := Default(TCollectionItem);
      if not (arr.Items[i] is TJSONObject) then
        continue;
      o := TJSONObject(arr.Items[i]);
      items[i].id := o.Get('id', '');
      items[i].title := o.Get('title', '');
      items[i].artist := o.Get('artist', '');
      items[i].itemType := o.Get('itemType', '');
      items[i].pageUrl := o.Get('pageUrl', '');
      items[i].coverUrl := o.Get('coverUrl', '');
      items[i].releaseDate := o.Get('releaseDate', '');
      items[i].hidden := o.Get('hidden', false);
    end;
    Result := age;
  finally
    data.Free;
  end;
end;

{** Human-readable age such as "3h" or "2d", for the cache message. }
function HumanAge(seconds: LongInt): string;
begin
  if seconds < 90 then
    HumanAge := Format('%ds', [seconds])
  else if seconds < 90 * 60 then
    HumanAge := Format('%dm', [seconds div 60])
  else if seconds < 48 * 60 * 60 then
    HumanAge := Format('%dh', [seconds div 3600])
  else
    HumanAge := Format('%dd', [seconds div (24 * 3600)]);
end;

{** Resolves a scope to its items, using the on-disk cache unless --refresh is
  given or the cache is stale. Fetches and rewrites the cache otherwise. }
function ResolveScope(backend: TMagicBackend;
  const backendName, scopeRef: string): TCollectionItemArray;
var
  age: LongInt;
begin
  if not HasFlag('--refresh') then begin
    age := ReadScopeCache(backendName, scopeRef, Result);
    if age >= 0 then begin
      gLog.Info(Format('Using cached scope (%s old, %d item(s)); ' +
        '--refresh to update.', [HumanAge(age), Length(Result)]));
      exit;
    end;
  end;
  Result := backend.ListScope(scopeRef);
  WriteScopeCache(backendName, scopeRef, Result);
end;

{** Lists and indexes a scope (a bundle, collection, ...) rather than the whole
  collection. It upserts only the scope's items and does NOT sweep, since it saw
  only part of the collection and must not mark the rest removed. }
procedure IndexScope(backend: TMagicBackend; index: TMagicIndex;
  const backendName, scopeRef: string; out items: TCollectionItemArray);
var
  seen: string;
  i: LongInt;
begin
  seen := NowIsoUtc;
  items := ResolveScope(backend, backendName, scopeRef);
  for i := 0 to High(items) do
    index.UpsertItem(backendName, items[i], seen);
  index.Commit;
end;

{** The --scope reference, validated against the backend. Raises when --scope was
  given but the backend cannot resolve one. Returns '' when --scope is absent. }
function ScopeArg(backend: TMagicBackend; const backendName: string): string;
begin
  Result := ArgValue('--scope', '');
  if (Result <> '') and not backend.SupportsScope then
    raise EMagicError.CreateFmt(
      'Backend "%s" does not support --scope.', [backendName]);
end;

{** A ' for "<account>"' clause for a banner line, or '' when the backend has no
  account name to show. Call after Authenticate so a backend that learns its
  account only then (itch.io, from the profile) can report it. }
function ForAccount(backend: TMagicBackend): string;
begin
  if backend.AccountLabel <> '' then
    ForAccount := Format(' for "%s"', [backend.AccountLabel])
  else
    ForAccount := '';
end;

{** Lists the scopes a backend offers for --scope, one per line as
  "<reference>  <description>". For itch.io these are the account's owned
  bundles; the reference is a bundle link to pass to --scope. }
procedure CmdScopes;
var
  backendClass: TMagicBackendClass;
  backend: TMagicBackend;
  s: TSession;
  ctx: TMagicContext;
  scopes: TScopeInfoArray;
  backendName: string;
  i: LongInt;
begin
  backendClass := RequireBackend(backendName);
  s := OpenSession;
  try
    ctx := BuildContext(s.index, s.cookies, s.http, backendName);
    backend := backendClass.Create(ctx);
    try
      LoadCookies(backendClass, s.cookies);
      backend.Authenticate;
      scopes := backend.ListScopes;
      if Length(scopes) = 0 then begin
        gLog.Info(Format('%s offers no listable scopes.', [backendName]));
        exit;
      end;
      for i := 0 to High(scopes) do
        Writeln(scopes[i].reference, '  ', scopes[i].caption);
    finally
      backend.Free;
    end;
  finally
    CloseSession(s);
  end;
end;

procedure CmdIndex;
var
  backendClass: TMagicBackendClass;
  backend: TMagicBackend;
  s: TSession;
  ctx: TMagicContext;
  items: TCollectionItemArray;
  backendName, scope: string;
begin
  backendClass := RequireBackend(backendName);
  s := OpenSession;
  try
    ctx := BuildContext(s.index, s.cookies, s.http, backendName);
    backend := backendClass.Create(ctx);
    try
      scope := ScopeArg(backend, backendName);
      LoadCookies(backendClass, s.cookies);
      backend.Authenticate;
      if scope <> '' then begin
        gLog.Info(Format('Indexing %s scope "%s"...', [backendName, scope]));
        IndexScope(backend, s.index, backendName, scope, items);
      end
      else begin
        gLog.Info(Format('Indexing %s collection%s...',
          [backendName, ForAccount(backend)]));
        IndexCollection(backend, s.index, backendName, items);
      end;
      gLog.Info(Format('Indexed %d items (%d total in database).',
        [Length(items), s.index.CountItems(backendName)]));
    finally
      backend.Free;
    end;
  finally
    CloseSession(s);
  end;
end;

{** A display name for an item's download folder. }
{** Builds an item filter from the command-line options shared by list and
  sync --from-index. }
function ParseItemFilter: TItemFilter;
begin
  Result.backend := ArgValue('--backend', '');
  Result.status := ArgValue('--status', '');
  if (Result.status <> '') and (Result.status <> ITEM_ACTIVE)
    and (Result.status <> ITEM_REMOVED) and (Result.status <> ITEM_PREORDER)
    and (Result.status <> ITEM_UNAVAILABLE) then
    raise EMagicError.CreateFmt(
      'Unknown status "%s" (active|removed|preorder|unavailable).',
      [Result.status]);
  Result.onlyHidden := HasFlag('--hidden');
  Result.onlyBlacklisted := HasFlag('--blacklisted');
  Result.onlySuperseded := HasFlag('--superseded');
  if HasFlag('--downloaded') then
    Result.downloaded := dfYes
  else if HasFlag('--not-downloaded') then
    Result.downloaded := dfNo
  else
    Result.downloaded := dfAny;
  Result.format := ArgValue('--format', '');
  Result.limit := StrToIntDef(ArgValue('--limit', ''), 0);
end;

{** True when fmt is in the desired set, or the set is empty (no filter). }
function FormatWanted(const fmt: string; const formats: TStringArray): boolean;
var
  i: LongInt;
begin
  if Length(formats) = 0 then
    exit(true);
  for i := 0 to High(formats) do
    if SameText(Trim(formats[i]), fmt) then
      exit(true);
  FormatWanted := false;
end;

{** Keeps only the targets whose format is wanted. }
function FilterTargets(const targets: TDownloadTargetArray;
  const formats: TStringArray): TDownloadTargetArray;
var
  i, n: LongInt;
begin
  if Length(formats) = 0 then
    exit(targets);
  Result := nil;
  for i := 0 to High(targets) do
    if FormatWanted(targets[i].format, formats) then begin
      n := Length(Result);
      SetLength(Result, n + 1);
      Result[n] := targets[i];
    end;
end;

function ItemDisplayName(const item: TCollectionItem): string;
begin
  if (item.artist <> '') and (item.title <> '') then
    ItemDisplayName := item.artist + ' - ' + item.title
  else if item.title <> '' then
    ItemDisplayName := item.title
  else if item.artist <> '' then
    ItemDisplayName := item.artist
  else
    ItemDisplayName := item.id;
end;

{** Sanitizes a '/'-separated relative subdirectory one level at a time, so each
  level is a safe file name and the slashes become real path separators. Empty
  levels (from a leading, trailing, or doubled slash) are dropped. }
function SanitizeSubdir(const sub: string): string;
var
  parts: TStringArray;
  i: LongInt;
begin
  Result := '';
  parts := sub.Split(['/']);
  for i := 0 to High(parts) do begin
    if parts[i] = '' then
      continue;
    if Result <> '' then
      Result := Result + PathDelim;
    Result := Result + SanitizeName(parts[i]);
  end;
end;

{** The output directory for an item: the backend's own layout when it has one
  (itch.io's "<user>.itch.io/<slug>", split into levels), otherwise the default
  single "Creator - Title" folder. The default is sanitized as one name, so a
  creator or title containing a slash stays one folder as before. }
function ItemOutputDir(backend: TMagicBackend; const ctx: TMagicContext;
  const item: TCollectionItem): string;
var
  sub, rel: string;
begin
  sub := backend.ItemSubdir(item);
  if sub <> '' then
    rel := SanitizeSubdir(sub)
  else
    rel := SanitizeName(ItemDisplayName(item));
  ItemOutputDir := IncludeTrailingPathDelimiter(ctx.outputDir) + rel;
end;

{** Downloads an item's files (a Bandcamp archive, or each of a DriveThruRPG
  product's files) into one folder, plus its cover when --covers is set. Records
  the version and each file in the index. Honors --dry-run. Returns true when
  something was fetched (or would have been, under dry-run). }
function SyncItem(backend: TMagicBackend; const ctx: TMagicContext;
  const backendName: string; const item: TCollectionItem;
  withCovers: boolean): boolean;
var
  targets: TDownloadTargetArray;
  availability: TAvailability;
  named: TCollectionItem;
  i: LongInt;
  itemDir, coverUrl, savedPath, sha, seen, fileName: string;
  fs: TFileStream;
  fileSize: Int64;
  fetchedAny: boolean;
begin
  SyncItem := false;
  seen := NowIsoUtc;

  if ctx.index.IsBlacklisted(backendName, item.id) then begin
    gLog.Debug(Format('  skip blacklisted "%s"', [item.id]));
    exit;
  end;

  if ctx.index.IsSuperseded(backendName, item.id) then begin
    gLog.Debug(Format('  skip superseded "%s"', [item.id]));
    exit;
  end;

  if ctx.index.IsImported(backendName, item.id) then begin
    gLog.Debug(Format('  skip imported "%s" (already owned locally)', [item.id]));
    exit;
  end;

  targets := backend.ResolveFiles(item, availability);

  if (availability <> avAvailable) or (Length(targets) = 0) then begin
    if availability = avPreorder then begin
      ctx.index.SetItemStatus(backendName, item.id, ITEM_PREORDER);
      gLog.Info(Format('  preorder "%s": not released yet',
        [ItemDisplayName(item)]));
    end
    else begin
      ctx.index.SetItemStatus(backendName, item.id, ITEM_UNAVAILABLE);
      gLog.Info(Format('  skip "%s": nothing downloadable', [item.id]));
    end;
    ctx.index.Commit;
    exit;
  end;

  { Keep only the wanted formats. An item that has files but none in the chosen
    format is left alone (it is available, just not in that format). }
  targets := FilterTargets(targets, ctx.formats);
  if Length(targets) = 0 then begin
    gLog.Info(Format('  skip "%s": no files in the selected format', [item.id]));
    exit;
  end;

  { Fold the resolved names back into the item, then record the version (all
    files of an item share it). }
  named := item;
  if targets[0].artist <> '' then named.artist := targets[0].artist;
  if targets[0].title <> '' then named.title := targets[0].title;
  ctx.index.UpsertItem(backendName, named, seen);
  ctx.index.UpsertVersion(backendName, item.id, targets[0].versionKey,
    targets[0].releasedAt, seen);

  itemDir := ItemOutputDir(backend, ctx, named);

  fetchedAny := false;
  for i := 0 to High(targets) do begin
    { Already have this exact file for this version. }
    if ctx.index.HasPresentFile(backendName, item.id, targets[i].versionKey,
      targets[i].name) then
      continue;

    if ctx.dryRun then begin
      gLog.Info(Format('  would download "%s" -> %s',
        [targets[i].suggestedName, itemDir]));
      fetchedAny := true;
      continue;
    end;

    fileName := SanitizeName(targets[i].suggestedName);
    gLog.Info(Format('  downloading "%s"...', [targets[i].suggestedName]));
    savedPath := ctx.http.Download(targets[i].downloadUrl, itemDir, fileName,
      pcNormal);

    sha := Sha256File(savedPath);
    fs := TFileStream.Create(savedPath, fmOpenRead or fmShareDenyNone);
    try
      fileSize := fs.Size;
    finally
      fs.Free;
    end;

    ctx.index.RecordFile(backendName, item.id, targets[i].versionKey,
      targets[i].name, targets[i].format, savedPath, fileSize, sha, seen);
    fetchedAny := true;
  end;

  if fetchedAny and (not ctx.dryRun) and withCovers then begin
    coverUrl := backend.ResolveCoverUrl(item);
    if coverUrl <> '' then
      ctx.http.Download(coverUrl, itemDir, 'cover.jpg', pcNormal);
  end;

  ctx.index.SetItemStatus(backendName, item.id, ITEM_ACTIVE);
  ctx.index.Commit;
  SyncItem := fetchedAny;
end;

procedure CmdSync;
var
  backendClass: TMagicBackendClass;
  backend: TMagicBackend;
  s: TSession;
  ctx: TMagicContext;
  items: TCollectionItemArray;
  filtered: TIndexedItemArray;
  f: TItemFilter;
  only: TStringArray;
  detail: TItemDetail;
  item: TCollectionItem;
  i, fetched: LongInt;
  withCovers: boolean;
  backendName, scope: string;
begin
  backendClass := RequireBackend(backendName);
  withCovers := HasFlag('--covers');
  { Optional positional item ids restrict the sync to just those items. }
  only := Positionals(['--backend', '--db', '--out', '--format', '--user',
    '--app-key', '--app-key-file', '--cookies', '--interval-ms', '--retries',
    '--timeout-ms', '--status', '--limit', '--scope']);
  s := OpenSession;
  try
    ctx := BuildContext(s.index, s.cookies, s.http, backendName);
    { sync writes files, so an output directory is required. }
    if ctx.outputDir = '' then
      RequireOutDir(backendName);
    backend := backendClass.Create(ctx);
    try
      scope := ScopeArg(backend, backendName);
      LoadCookies(backendClass, s.cookies);
      backend.Authenticate;
      gLog.Info(Format('Syncing %s collection%s...',
        [backendName, ForAccount(backend)]));

      fetched := 0;
      if Length(only) > 0 then begin
        { Targeted sync: resolve the named items from the index, no full listing. }
        gLog.Info(Format('Syncing %d item(s) from the index...', [Length(only)]));
        for i := 0 to High(only) do begin
          if not s.index.GetItem(backendName, only[i], detail) then begin
            gLog.Warn(Format('item "%s" is not indexed; run index first',
              [only[i]]));
            continue;
          end;
          item := Default(TCollectionItem);
          item.id := detail.backendId;
          item.title := detail.title;
          item.artist := detail.creator;
          item.itemType := detail.kind;
          item.pageUrl := detail.pageUrl;
          if SyncItem(backend, ctx, backendName, item, withCovers) then
            Inc(fetched);
        end;
      end
      else if scope <> '' then begin
        { Scoped sync: list only the scope (a bundle, ...), index it without
          sweeping, and download those items. }
        IndexScope(backend, s.index, backendName, scope, items);
        gLog.Info(Format('%d item(s) in scope.', [Length(items)]));
        for i := 0 to High(items) do
          if SyncItem(backend, ctx, backendName, items[i], withCovers) then
            Inc(fetched);
      end
      else if HasFlag('--from-index') then begin
        { Download everything already indexed, without re-listing from the API.
          Filters (--not-downloaded, --status, --limit, ...) narrow the set. }
        f := ParseItemFilter;
        f.backend := backendName;
        filtered := s.index.ListItems(f);
        gLog.Info(Format('Syncing %d indexed item(s) (no listing)...',
          [Length(filtered)]));
        for i := 0 to High(filtered) do begin
          item := Default(TCollectionItem);
          item.id := filtered[i].backendId;
          item.title := filtered[i].title;
          item.artist := filtered[i].creator;
          item.itemType := filtered[i].kind;
          item.pageUrl := filtered[i].pageUrl;
          if SyncItem(backend, ctx, backendName, item, withCovers) then
            Inc(fetched);
        end;
      end
      else begin
        { Full sync: list the whole collection to catch new and changed items. }
        IndexCollection(backend, s.index, backendName, items);
        gLog.Info(Format('%d items in collection.', [Length(items)]));
        for i := 0 to High(items) do
          if SyncItem(backend, ctx, backendName, items[i], withCovers) then
            Inc(fetched);
      end;
      gLog.Info(Format('Sync done: %d fetched.', [fetched]));
    finally
      backend.Free;
    end;
  finally
    CloseSession(s);
  end;
end;

{** Recursively hashes every file under dir into map (sha256 -> path). Used to
  relocate files that were moved or renamed on disk. }
procedure ScanDirHashes(const dir: string; map: TFPStringHashTable);
var
  info: TSearchRec;
  full: string;
begin
  if FindFirst(IncludeTrailingPathDelimiter(dir) + '*', faAnyFile, info) <> 0 then
    exit;
  try
    repeat
      if (info.Name = '.') or (info.Name = '..') then
        continue;
      full := IncludeTrailingPathDelimiter(dir) + info.Name;
      if (info.Attr and faDirectory) <> 0 then
        ScanDirHashes(full, map)
      else
        map[Sha256File(full)] := full;
    until FindNext(info) <> 0;
  finally
    FindClose(info);
  end;
end;

{** Compares an item's local files to the store's current version by hash and
  returns a one-word state: 'current' (every current file held locally matches,
  none missing), 'outdated' (a local file's hash differs from the current one),
  'incomplete' (present files match but some current files are not held),
  'not-downloaded' (nothing local), or 'preorder'/'unavailable' from the store.
  'unknown' when the store offers no hash to compare. }
function CheckItemState(backend: TMagicBackend; const backendName: string;
  index: TMagicIndex; const item: TCollectionItem): string;
var
  targets: TDownloadTargetArray;
  availability: TAvailability;
  files: TFileInfoArray;
  importedPath, cand, localPath, localHash: string;
  i, j, matched, mismatched, missing: LongInt;
  found: boolean;
begin
  { Decide first whether anything is held locally. If not, report it without
    contacting the store, so a check over a large library makes a request only
    for the items actually on disk. }
  importedPath := index.GetImportedPath(backendName, item.id);
  files := index.ItemFiles(backendName, item.id);
  if (importedPath = '') and (Length(files) = 0) then
    exit('not-downloaded');

  targets := backend.ResolveFiles(item, availability);
  if availability = avPreorder then
    exit('preorder');
  if (availability <> avAvailable) or (Length(targets) = 0) then
    exit('unavailable');

  matched := 0;
  mismatched := 0;
  missing := 0;
  for i := 0 to High(targets) do begin
    { Find the local file for this current target: a recorded present file of
      the same name, or, for an adopted item, the file in the imported folder. }
    localPath := '';
    found := false;
    for j := 0 to High(files) do
      if (files[j].name = targets[i].name) and (files[j].state = 'present') then begin
        localPath := files[j].path;
        found := true;
        break;
      end;
    if (not found) and (importedPath <> '') then begin
      cand := IncludeTrailingPathDelimiter(importedPath) +
        SanitizeName(targets[i].suggestedName);
      if FileExists(cand) then begin
        localPath := cand;
        found := true;
      end
      else begin
        cand := IncludeTrailingPathDelimiter(importedPath) + targets[i].suggestedName;
        if FileExists(cand) then begin
          localPath := cand;
          found := true;
        end;
      end;
    end;
    if (not found) or (not FileExists(localPath)) then begin
      Inc(missing);
      continue;
    end;

    if (targets[i].hash <> '') and (targets[i].hashAlgo <> '') then begin
      try
        localHash := HashFile(targets[i].hashAlgo, localPath);
      except
        on E: Exception do begin
          gLog.Debug(Format('  hash failed for %s: %s', [localPath, E.Message]));
          Inc(missing);
          continue;
        end;
      end;
      if SameText(localHash, targets[i].hash) then
        Inc(matched)
      else
        Inc(mismatched);
    end
    else
      Inc(matched);  { present but no hash to verify against }
  end;

  if mismatched > 0 then
    CheckItemState := 'outdated'
  else if missing > 0 then
    CheckItemState := 'incomplete'
  else if matched > 0 then
    CheckItemState := 'current'
  else
    CheckItemState := 'unknown';
end;

{** Reports, per item, whether the local copy matches the store's current
  version (see CheckItemState). Scope it with item ids or the list filters, as
  it resolves and hashes each item. }
procedure CmdCheck;
var
  backendClass: TMagicBackendClass;
  backend: TMagicBackend;
  s: TSession;
  ctx: TMagicContext;
  f: TItemFilter;
  only: TStringArray;
  indexed: TIndexedItemArray;
  detail: TItemDetail;
  item: TCollectionItem;
  backendName: string;
  i, nCur, nOut, nInc, nNo, nUnavail: LongInt;

  procedure Report(const it: TCollectionItem);
  var
    st: string;
  begin
    try
      st := CheckItemState(backend, backendName, s.index, it);
    except
      on E: Exception do begin
        gLog.Warn(Format('  check failed for %s: %s', [it.id, E.Message]));
        Inc(nUnavail);
        exit;
      end;
    end;
    if st = 'current' then Inc(nCur)
    else if st = 'outdated' then Inc(nOut)
    else if st = 'incomplete' then Inc(nInc)
    else if st = 'not-downloaded' then Inc(nNo)
    else Inc(nUnavail);  { preorder, unavailable, unknown }
    gLog.Info(Format('  %-14s %s  [%s]', [st, ItemDisplayName(it), it.id]));
  end;

begin
  backendClass := RequireBackend(backendName);
  only := Positionals(['--backend', '--db', '--status', '--limit', '--format',
    '--user', '--app-key', '--app-key-file', '--cookies', '--interval-ms',
    '--retries', '--timeout-ms', '--scope']);
  nCur := 0; nOut := 0; nInc := 0; nNo := 0; nUnavail := 0;
  s := OpenSession;
  try
    ctx := BuildContext(s.index, s.cookies, s.http, backendName);
    backend := backendClass.Create(ctx);
    try
      LoadCookies(backendClass, s.cookies);
      backend.Authenticate;
      if Length(only) > 0 then begin
        for i := 0 to High(only) do begin
          if not s.index.GetItem(backendName, only[i], detail) then begin
            gLog.Warn(Format('item "%s" is not indexed; run index first',
              [only[i]]));
            continue;
          end;
          item := Default(TCollectionItem);
          item.id := detail.backendId;
          item.title := detail.title;
          item.artist := detail.creator;
          item.itemType := detail.kind;
          item.pageUrl := detail.pageUrl;
          Report(item);
        end;
      end
      else begin
        f := ParseItemFilter;
        f.backend := backendName;
        indexed := s.index.ListItems(f);
        gLog.Info(Format('Checking %d item(s) against %s...',
          [Length(indexed), backendName]));
        for i := 0 to High(indexed) do begin
          item := Default(TCollectionItem);
          item.id := indexed[i].backendId;
          item.title := indexed[i].title;
          item.artist := indexed[i].creator;
          item.pageUrl := indexed[i].pageUrl;
          Report(item);
        end;
      end;
      gLog.Info(Format(
        '%d current, %d outdated, %d incomplete, %d not downloaded, %d other.',
        [nCur, nOut, nInc, nNo, nUnavail]));
    finally
      backend.Free;
    end;
  finally
    CloseSession(s);
  end;
end;

procedure CmdVerify;
var
  index: TMagicIndex;
  files, missingFiles: TIndexedFileArray;
  backend, scanDir, seen, found: string;
  rehash, rescan, jsonMode, didRescan: boolean;
  i, present, missing, repaired, mismatched: LongInt;
  map: TFPStringHashTable;
  mismatches, stillMissing: TStringList;
  relocFrom, relocTo: TStringList;
  root, ro: TJSONObject;
  arr: TJSONArray;
begin
  backend := ArgValue('--backend', '');
  rehash := HasFlag('--rehash');
  rescan := HasFlag('--rescan');
  jsonMode := HasFlag('--json');
  scanDir := RequireOutDir(backend);

  mismatches := TStringList.Create;
  stillMissing := TStringList.Create;
  relocFrom := TStringList.Create;
  relocTo := TStringList.Create;
  index := TMagicIndex.Create(ResolveDbPath);
  try
    files := index.AllFiles(backend);
    present := 0; missing := 0; repaired := 0; mismatched := 0;
    missingFiles := nil;
    didRescan := false;
    seen := NowIsoUtc;

    { Pass 1: presence, and optional integrity check of present files. }
    for i := 0 to High(files) do begin
      if FileExists(files[i].path) then begin
        if rehash and (files[i].sha256 <> '') then
          if Sha256File(files[i].path) <> files[i].sha256 then begin
            Inc(mismatched);
            mismatches.Add(files[i].path);
            if not jsonMode then
              gLog.Warn(Format('hash mismatch: %s', [files[i].path]));
          end;
        index.SetFileState(files[i].id, 'present', seen);
        Inc(present);
      end
      else begin
        index.SetFileState(files[i].id, 'missing', seen);
        SetLength(missingFiles, Length(missingFiles) + 1);
        missingFiles[High(missingFiles)] := files[i];
        Inc(missing);
      end;
    end;
    index.Commit;

    { Pass 2: repair moved/renamed files by matching content hash. }
    if rescan and (missing > 0) and DirectoryExists(scanDir) then begin
      didRescan := true;
      if not jsonMode then
        gLog.Info(Format('Rescanning %s to relocate %d missing file(s)...',
          [scanDir, missing]));
      map := TFPStringHashTable.Create;
      try
        ScanDirHashes(scanDir, map);
        seen := NowIsoUtc;
        for i := 0 to High(missingFiles) do begin
          found := '';
          if missingFiles[i].sha256 <> '' then
            found := map[missingFiles[i].sha256];
          if (found <> '') and FileExists(found) then begin
            index.UpdateFilePath(missingFiles[i].id, found, seen);
            relocFrom.Add(missingFiles[i].path);
            relocTo.Add(found);
            if not jsonMode then
              gLog.Info(Format('  relocated: %s -> %s',
                [missingFiles[i].path, found]));
            Inc(repaired);
            Dec(missing);
            Inc(present);  { relocated file is now present at its new path }
          end
          else
            stillMissing.Add(missingFiles[i].path);
        end;
        index.Commit;
      finally
        map.Free;
      end;
    end;

    if not didRescan then
      for i := 0 to High(missingFiles) do
        stillMissing.Add(missingFiles[i].path);

    if jsonMode then begin
      root := TJSONObject.Create;
      try
        root.Add('present', present);
        root.Add('missing', missing);
        root.Add('relocated', repaired);
        root.Add('mismatched', mismatched);
        arr := TJSONArray.Create;
        for i := 0 to relocFrom.Count - 1 do begin
          ro := TJSONObject.Create;
          ro.Add('from', relocFrom[i]);
          ro.Add('to', relocTo[i]);
          arr.Add(ro);
        end;
        root.Add('relocations', arr);
        arr := TJSONArray.Create;
        for i := 0 to mismatches.Count - 1 do
          arr.Add(mismatches[i]);
        root.Add('mismatches', arr);
        arr := TJSONArray.Create;
        for i := 0 to stillMissing.Count - 1 do
          arr.Add(stillMissing[i]);
        root.Add('missing_files', arr);
        Writeln(root.FormatJSON);
      finally
        root.Free;
      end;
    end
    else
      gLog.Info(Format(
        'Verify: %d present, %d missing, %d relocated, %d mismatched.',
        [present, missing, repaired, mismatched]));
  finally
    index.Free;
    mismatches.Free;
    stillMissing.Free;
    relocFrom.Free;
    relocTo.Free;
  end;
end;

{** Sets or clears the blacklist flag on the item ids given as positional
  arguments. Blacklisted items are skipped by sync. }
procedure SetBlacklistForIds(blacklist: boolean; const reason: string);
var
  backendName, action: string;
  ids: TStringArray;
  index: TMagicIndex;
  i, changed: LongInt;
  jsonMode: boolean;
  changedIds, notIndexed: TStringList;
  root: TJSONObject;
  arr: TJSONArray;
begin
  backendName := ArgValue('--backend', '');
  if FindBackend(backendName) = nil then
    raise EMagicError.CreateFmt('Unknown backend: "%s". Try list-backends.',
      [backendName]);
  ids := Positionals(['--backend', '--db', '--reason']);
  if Length(ids) = 0 then
    raise EMagicError.Create('Give at least one item id.');
  jsonMode := HasFlag('--json');
  if blacklist then action := 'blacklist' else action := 'allow';

  changedIds := TStringList.Create;
  notIndexed := TStringList.Create;
  index := TMagicIndex.Create(ResolveDbPath);
  try
    changed := 0;
    for i := 0 to High(ids) do begin
      if not index.ItemExists(backendName, ids[i]) then begin
        notIndexed.Add(ids[i]);
        if not jsonMode then
          gLog.Warn(Format('item "%s" is not indexed; run index first',
            [ids[i]]));
        continue;
      end;
      index.SetBlacklist(backendName, ids[i], blacklist, reason);
      changedIds.Add(ids[i]);
      Inc(changed);
    end;
    index.Commit;

    if jsonMode then begin
      root := TJSONObject.Create;
      try
        root.Add('action', action);
        root.Add('changed', changed);
        arr := TJSONArray.Create;
        for i := 0 to changedIds.Count - 1 do
          arr.Add(changedIds[i]);
        root.Add('ids', arr);
        arr := TJSONArray.Create;
        for i := 0 to notIndexed.Count - 1 do
          arr.Add(notIndexed[i]);
        root.Add('not_indexed', arr);
        Writeln(root.FormatJSON);
      finally
        root.Free;
      end;
    end
    else if blacklist then
      gLog.Info(Format('Blacklisted %d item(s).', [changed]))
    else
      gLog.Info(Format('Allowed %d item(s).', [changed]));
  finally
    index.Free;
    changedIds.Free;
    notIndexed.Free;
  end;
end;

{** Records a remote id relocation: the old item is superseded by the new one. }
procedure CmdRelocate;
var
  backendName, oldId, newId: string;
  ids: TStringArray;
  index: TMagicIndex;
  root: TJSONObject;
begin
  backendName := ArgValue('--backend', '');
  if FindBackend(backendName) = nil then
    raise EMagicError.CreateFmt('Unknown backend: "%s". Try list-backends.',
      [backendName]);
  ids := Positionals(['--backend', '--db']);
  if Length(ids) <> 2 then
    raise EMagicError.Create('Usage: relocate --backend X <old-id> <new-id>');
  oldId := ids[0];
  newId := ids[1];

  index := TMagicIndex.Create(ResolveDbPath);
  try
    if not index.ItemExists(backendName, oldId) then
      raise EMagicError.CreateFmt('Old item "%s" is not indexed.', [oldId]);
    if not index.ItemExists(backendName, newId) then
      raise EMagicError.CreateFmt(
        'New item "%s" is not indexed; index it first.', [newId]);
    index.SetSuperseded(backendName, oldId, newId);
    index.Commit;
    if HasFlag('--json') then begin
      root := TJSONObject.Create;
      try
        root.Add('action', 'relocate');
        root.Add('from', oldId);
        root.Add('to', newId);
        Writeln(root.FormatJSON);
      finally
        root.Free;
      end;
    end
    else
      gLog.Info(Format('Relocated %s -> %s.', [oldId, newId]));
  finally
    index.Free;
  end;
end;

{** Emits one item's full detail (metadata, versions, nested files) as JSON. }
procedure DetailsJson(const item: TItemDetail;
  const versions: TVersionInfoArray; const files: TFileInfoArray);
var
  root, vo, fo: TJSONObject;
  varr, farr: TJSONArray;
  i, j: LongInt;
begin
  root := TJSONObject.Create;
  try
    root.Add('backend', item.backend);
    root.Add('id', item.backendId);
    root.Add('kind', item.kind);
    root.Add('title', item.title);
    root.Add('creator', item.creator);
    root.Add('page_url', item.pageUrl);
    root.Add('cover_url', item.coverUrl);
    root.Add('status', item.status);
    root.Add('hidden', item.hidden);
    root.Add('blacklisted', item.blacklisted);
    root.Add('blacklist_reason', item.blacklistReason);
    if item.supersededBy = '' then
      root.Add('superseded_by', TJSONNull.Create)
    else
      root.Add('superseded_by', item.supersededBy);
    root.Add('first_seen', item.firstSeen);
    root.Add('last_seen', item.lastSeen);

    varr := TJSONArray.Create;
    for i := 0 to High(versions) do begin
      vo := TJSONObject.Create;
      vo.Add('version_key', versions[i].versionKey);
      vo.Add('released_at', versions[i].releasedAt);
      vo.Add('current', versions[i].isCurrent);
      vo.Add('first_seen', versions[i].firstSeen);
      vo.Add('last_seen', versions[i].lastSeen);
      farr := TJSONArray.Create;
      for j := 0 to High(files) do
        if files[j].versionKey = versions[i].versionKey then begin
          fo := TJSONObject.Create;
          fo.Add('name', files[j].name);
          fo.Add('format', files[j].format);
          fo.Add('size', files[j].size);
          fo.Add('state', files[j].state);
          fo.Add('sha256', files[j].sha256);
          fo.Add('path', files[j].path);
          fo.Add('downloaded_at', files[j].downloadedAt);
          fo.Add('checked_at', files[j].checkedAt);
          farr.Add(fo);
        end;
      vo.Add('files', farr);
      varr.Add(vo);
    end;
    root.Add('versions', varr);
    Writeln(root.FormatJSON);
  finally
    root.Free;
  end;
end;

procedure CmdDetails;
var
  index: TMagicIndex;
  backend, id: string;
  ids: TStringArray;
  item: TItemDetail;
  versions: TVersionInfoArray;
  files: TFileInfoArray;
  i, j: LongInt;
  line, cur: string;
begin
  backend := ArgValue('--backend', '');
  if FindBackend(backend) = nil then
    raise EMagicError.CreateFmt('Unknown backend: "%s". Try list-backends.',
      [backend]);
  ids := Positionals(['--backend', '--db']);
  if Length(ids) <> 1 then
    raise EMagicError.Create('Usage: details --backend X <item-id>');
  id := ids[0];

  index := TMagicIndex.Create(ResolveDbPath);
  try
    if not index.GetItem(backend, id, item) then
      raise EMagicError.CreateFmt('Item "%s" is not indexed.', [id]);

    versions := index.ItemVersions(backend, id);
    files := index.ItemFiles(backend, id);

    if HasFlag('--json') then begin
      DetailsJson(item, versions, files);
      exit;
    end;

    gLog.Info(Format('Item %s (%s)', [item.backendId, item.backend]));
    gLog.Info(Format('  title:      %s', [item.title]));
    gLog.Info(Format('  creator:    %s', [item.creator]));
    gLog.Info(Format('  kind:       %s', [item.kind]));
    line := item.status;
    if item.hidden then line := line + ', hidden';
    if item.blacklisted then begin
      line := line + ', blacklisted';
      if item.blacklistReason <> '' then
        line := line + ' (' + item.blacklistReason + ')';
    end;
    if item.supersededBy <> '' then
      line := line + ', superseded by ' + item.supersededBy;
    gLog.Info(Format('  status:     %s', [line]));
    if item.pageUrl <> '' then
      gLog.Info(Format('  page:       %s', [item.pageUrl]));
    if item.coverUrl <> '' then
      gLog.Info(Format('  cover:      %s', [item.coverUrl]));
    gLog.Info(Format('  first seen: %s', [item.firstSeen]));
    gLog.Info(Format('  last seen:  %s', [item.lastSeen]));

    if Length(versions) = 0 then begin
      gLog.Info('  versions:   (none resolved yet)');
      exit;
    end;

    gLog.Info('  versions:');
    for i := 0 to High(versions) do begin
      if versions[i].isCurrent then cur := ' (current)' else cur := '';
      gLog.Info(Format('    %s%s  released %s  seen %s .. %s',
        [versions[i].versionKey, cur, versions[i].releasedAt,
         versions[i].firstSeen, versions[i].lastSeen]));
      for j := 0 to High(files) do
        if files[j].versionKey = versions[i].versionKey then
          gLog.Info(Format('      %s  (%s, %d bytes, %s)  -> %s',
            [files[j].name, files[j].format, files[j].size, files[j].state,
             files[j].path]));
    end;
  finally
    index.Free;
  end;
end;

{** Emits a filtered item list as JSON. }
procedure ListItemsJson(const items: TIndexedItemArray);
var
  root: TJSONObject;
  arr: TJSONArray;
  o: TJSONObject;
  i: LongInt;
begin
  root := TJSONObject.Create;
  try
    arr := TJSONArray.Create;
    for i := 0 to High(items) do begin
      o := TJSONObject.Create;
      o.Add('id', items[i].backendId);
      o.Add('kind', items[i].kind);
      o.Add('title', items[i].title);
      o.Add('creator', items[i].creator);
      o.Add('status', items[i].status);
      o.Add('hidden', items[i].hidden);
      o.Add('blacklisted', items[i].blacklisted);
      o.Add('superseded', items[i].superseded);
      o.Add('downloaded', items[i].downloaded);
      arr.Add(o);
    end;
    root.Add('count', Length(items));
    root.Add('items', arr);
    Writeln(root.FormatJSON);
  finally
    root.Free;
  end;
end;

procedure CmdList;
var
  index: TMagicIndex;
  f: TItemFilter;
  items: TIndexedItemArray;
  i: LongInt;
  flags, dl, name: string;
begin
  f := ParseItemFilter;
  index := TMagicIndex.Create(ResolveDbPath);
  try
    items := index.ListItems(f);

    if HasFlag('--json') then begin
      ListItemsJson(items);
      exit;
    end;

    if Length(items) = 0 then begin
      gLog.Info('No items match.');
      exit;
    end;
    gLog.Info(Format('%-3s %-11s %-3s %s', ['DL', 'STATUS', 'HBS', 'ITEM']));
    for i := 0 to High(items) do begin
      if items[i].downloaded then dl := ' * ' else dl := ' . ';
      flags := '';
      if items[i].hidden then flags := flags + 'H' else flags := flags + '-';
      if items[i].blacklisted then flags := flags + 'B' else flags := flags + '-';
      if items[i].superseded then flags := flags + 'S' else flags := flags + '-';
      if (items[i].creator <> '') and (items[i].title <> '') then
        name := items[i].creator + ' - ' + items[i].title
      else if items[i].title <> '' then
        name := items[i].title
      else if items[i].creator <> '' then
        name := items[i].creator
      else
        name := '(no title)';
      gLog.Info(Format('%-3s %-11s %-3s %s  [%s]',
        [dl, items[i].status, flags, name, items[i].backendId]));
    end;
    gLog.Info(Format('%d item(s).', [Length(items)]));
  finally
    index.Free;
  end;
end;

{** Formats a byte count as a human-readable size (B, KiB, MiB, GiB, TiB). }
function HumanSize(bytes: Int64): string;
const
  UNITS: array[0..4] of string = ('B', 'KiB', 'MiB', 'GiB', 'TiB');
var
  v: Double;
  i: LongInt;
begin
  v := bytes;
  i := 0;
  while (v >= 1024) and (i < High(UNITS)) do begin
    v := v / 1024;
    Inc(i);
  end;
  if i = 0 then
    HumanSize := Format('%d %s', [bytes, UNITS[0]])
  else
    HumanSize := Format('%.1f %s', [v, UNITS[i]]);
end;

{** Prints one summary block for the given backend (empty = all), under heading. }
procedure PrintSummary(index: TMagicIndex; const backend, heading: string);
var
  st: TIndexStats;
  fmts: TFormatCountArray;
  line: string;
  i: LongInt;
begin
  st := index.Stats(backend);
  gLog.Info(heading);
  gLog.Info(Format('  items:         %d', [st.items]));
  gLog.Info(Format('    active:        %d', [st.active]));
  gLog.Info(Format('    preorder:      %d', [st.preorder]));
  gLog.Info(Format('    unavailable:   %d', [st.unavailable]));
  gLog.Info(Format('    removed:       %d', [st.removed]));
  gLog.Info(Format('  hidden:        %d', [st.hidden]));
  gLog.Info(Format('  blacklisted:   %d', [st.blacklisted]));
  gLog.Info(Format('  superseded:    %d', [st.superseded]));
  gLog.Info(Format('  imported:      %d', [st.imported]));
  gLog.Info(Format('  versions:      %d', [st.versions]));
  gLog.Info(Format('  downloaded:    %d items (current version)',
    [st.downloadedItems]));
  gLog.Info(Format('  files:         %d present, %d missing',
    [st.filesPresent, st.filesMissing]));
  gLog.Info(Format('  size:          %s (present)', [HumanSize(st.bytesPresent)]));

  fmts := index.FormatCounts(backend);
  if Length(fmts) > 0 then begin
    gLog.Info('  formats:');
    for i := 0 to High(fmts) do begin
      line := Format('%d present', [fmts[i].present]);
      if fmts[i].missing > 0 then
        line := line + Format(', %d missing', [fmts[i].missing]);
      line := line + Format(', %s', [HumanSize(fmts[i].bytes)]);
      gLog.Info(Format('    %-10s %s', [fmts[i].format, line]));
    end;
  end;
end;

{** Builds one backend's stats as a JSON object (name labels the scope). }
function StatsToJson(index: TMagicIndex;
  const backend, name: string): TJSONObject;
var
  st: TIndexStats;
  fmts: TFormatCountArray;
  items, files, fo: TJSONObject;
  arr: TJSONArray;
  i: LongInt;
begin
  st := index.Stats(backend);
  Result := TJSONObject.Create;
  Result.Add('backend', name);

  items := TJSONObject.Create;
  items.Add('total', st.items);
  items.Add('active', st.active);
  items.Add('preorder', st.preorder);
  items.Add('unavailable', st.unavailable);
  items.Add('removed', st.removed);
  Result.Add('items', items);

  Result.Add('hidden', st.hidden);
  Result.Add('blacklisted', st.blacklisted);
  Result.Add('superseded', st.superseded);
  Result.Add('imported', st.imported);
  Result.Add('versions', st.versions);
  Result.Add('downloaded_items', st.downloadedItems);

  files := TJSONObject.Create;
  files.Add('present', st.filesPresent);
  files.Add('missing', st.filesMissing);
  Result.Add('files', files);
  Result.Add('bytes_present', st.bytesPresent);

  arr := TJSONArray.Create;
  fmts := index.FormatCounts(backend);
  for i := 0 to High(fmts) do begin
    fo := TJSONObject.Create;
    fo.Add('format', fmts[i].format);
    fo.Add('present', fmts[i].present);
    fo.Add('missing', fmts[i].missing);
    fo.Add('bytes', fmts[i].bytes);
    arr.Add(fo);
  end;
  Result.Add('formats', arr);
end;

procedure StatusJson(index: TMagicIndex; const backend: string);
var
  root: TJSONObject;
  arr: TJSONArray;
  backends: TStringArray;
  i: LongInt;
begin
  root := TJSONObject.Create;
  try
    arr := TJSONArray.Create;
    if backend <> '' then
      arr.Add(StatsToJson(index, backend, backend))
    else begin
      backends := index.Backends;
      for i := 0 to High(backends) do
        arr.Add(StatsToJson(index, backends[i], backends[i]));
    end;
    root.Add('backends', arr);
    root.Add('total', StatsToJson(index, backend, 'all'));
    Writeln(root.FormatJSON);
  finally
    root.Free;  { frees the whole tree }
  end;
end;

procedure CmdStatus;
var
  index: TMagicIndex;
  backend: string;
  backends: TStringArray;
  i: LongInt;
begin
  backend := ArgValue('--backend', '');
  index := TMagicIndex.Create(ResolveDbPath);
  try
    if HasFlag('--json') then begin
      StatusJson(index, backend);
      exit;
    end;

    if backend <> '' then
      PrintSummary(index, backend, Format('Collection status (%s):', [backend]))
    else begin
      backends := index.Backends;
      if Length(backends) <= 1 then
        PrintSummary(index, '', 'Collection status (all backends):')
      else begin
        gLog.Info('Collection status:');
        for i := 0 to High(backends) do begin
          gLog.Info('');
          PrintSummary(index, backends[i], backends[i] + ':');
        end;
        gLog.Info('');
        PrintSummary(index, '', 'all backends:');
      end;
    end;
  finally
    index.Free;
  end;
end;

procedure CmdBlacklist;
begin
  SetBlacklistForIds(true, ArgValue('--reason', ''));
end;

procedure CmdAllow;
begin
  SetBlacklistForIds(false, '');
end;

{** Clears the adopted (imported) mark on the item ids given, so sync stops
  skipping them and fetches them again. The files on disk are left untouched;
  this only forgets that magicdl considered the item already owned locally. Use
  it to refresh an adopted item whose store version has changed. }
procedure CmdForget;
var
  backendName: string;
  ids: TStringArray;
  index: TMagicIndex;
  i, cleared, notAdopted: LongInt;
  jsonMode: boolean;
  clearedIds, notIndexed, notAdoptedIds: TStringList;
  root: TJSONObject;
  arr: TJSONArray;
begin
  backendName := ArgValue('--backend', '');
  if FindBackend(backendName) = nil then
    raise EMagicError.CreateFmt('Unknown backend: "%s". Try list-backends.',
      [backendName]);
  ids := Positionals(['--backend', '--db']);
  if Length(ids) = 0 then
    raise EMagicError.Create('Give at least one item id.');
  jsonMode := HasFlag('--json');

  clearedIds := TStringList.Create;
  notIndexed := TStringList.Create;
  notAdoptedIds := TStringList.Create;
  index := TMagicIndex.Create(ResolveDbPath);
  try
    cleared := 0;
    notAdopted := 0;
    for i := 0 to High(ids) do begin
      if not index.ItemExists(backendName, ids[i]) then begin
        notIndexed.Add(ids[i]);
        if not jsonMode then
          gLog.Warn(Format('item "%s" is not indexed; run index first',
            [ids[i]]));
        continue;
      end;
      if not index.IsImported(backendName, ids[i]) then begin
        notAdoptedIds.Add(ids[i]);
        Inc(notAdopted);
        if not jsonMode then
          gLog.Info(Format('  not adopted: %s', [ids[i]]));
        continue;
      end;
      index.SetImported(backendName, ids[i], '');
      clearedIds.Add(ids[i]);
      Inc(cleared);
    end;
    index.Commit;

    if jsonMode then begin
      root := TJSONObject.Create;
      try
        root.Add('action', 'forget');
        root.Add('cleared', cleared);
        arr := TJSONArray.Create;
        for i := 0 to clearedIds.Count - 1 do
          arr.Add(clearedIds[i]);
        root.Add('ids', arr);
        arr := TJSONArray.Create;
        for i := 0 to notAdoptedIds.Count - 1 do
          arr.Add(notAdoptedIds[i]);
        root.Add('not_adopted', arr);
        arr := TJSONArray.Create;
        for i := 0 to notIndexed.Count - 1 do
          arr.Add(notIndexed[i]);
        root.Add('not_indexed', arr);
        Writeln(root.FormatJSON);
      finally
        root.Free;
      end;
    end
    else
      gLog.Info(Format('Forgot %d adopted item(s); %d were not adopted.',
        [cleared, notAdopted]));
  finally
    index.Free;
    clearedIds.Free;
    notIndexed.Free;
    notAdoptedIds.Free;
  end;
end;

{** Strips a leading "YYYY - " (year and separator) from an album folder name,
  matching how the reference tool prefixes album folders. }
function StripYearPrefix(const s: string): string;
begin
  StripYearPrefix := s;
  if (Length(s) >= 7) and (s[1] in ['0'..'9']) and (s[2] in ['0'..'9'])
    and (s[3] in ['0'..'9']) and (s[4] in ['0'..'9'])
    and (Copy(s, 5, 3) = ' - ') then
    StripYearPrefix := Copy(s, 8, Length(s));
end;

{** Marks indexed items whose files already sit in an external directory, so
  sync skips them (adopting a hand-built archive). Two matching styles: most
  backends match a music library by identity (the Artist folder equals
  SanitizeName(creator), and the album folder, minus a "YYYY - " prefix, equals
  SanitizeName(title)); a path backend such as itch.io matches its own download
  layout, "<user>.itch.io/<slug>", as a direct folder lookup. --dry-run reports
  without marking. The collection must be indexed first. }
{** Folds loose files in a path-based archive into the per-item subfolders the
  backend expects. For each host that owns exactly one indexed item, the files
  sitting directly under <host>/ are moved into <host>/<slug>/, so a later
  import can adopt them. Hosts that own several items are left untouched: a
  loose file there cannot be assigned to one item without hashing it against
  the store. Non-file entries (slug subfolders, NAS metadata) are left in place.
  --dry-run reports the moves without making them. }
procedure CmdReorganize;
var
  backendClass: TMagicBackendClass;
  backend: TMagicBackend;
  ctx: TMagicContext;
  backendName, dir, rel, host, hostDir, targetDir, srcFile, dstFile: string;
  args: TStringArray;
  index: TMagicIndex;
  items: TIndexedItemArray;
  citem: TCollectionItem;
  hosts, loose: TStringList;
  f: TItemFilter;
  rec: TSearchRec;
  i, idx, p, k, movedHere: LongInt;
  foldered, filesMoved, multiHosts, skippedFiles: LongInt;
  dryRun: boolean;

  procedure FillItem(n: LongInt);
  begin
    citem := Default(TCollectionItem);
    citem.id := items[n].backendId;
    citem.title := items[n].title;
    citem.artist := items[n].creator;
    citem.pageUrl := items[n].pageUrl;
  end;

  function CountLooseFiles(const d: string): LongInt;
  var
    r: TSearchRec;
  begin
    Result := 0;
    if FindFirst(IncludeTrailingPathDelimiter(d) + '*', faAnyFile, r) = 0 then
    try
      repeat
        if (r.Attr and faDirectory) = 0 then
          Inc(Result);
      until FindNext(r) <> 0;
    finally
      FindClose(r);
    end;
  end;

begin
  backendName := ArgValue('--backend', '');
  backendClass := FindBackend(backendName);
  if backendClass = nil then
    raise EMagicError.CreateFmt('Unknown backend: "%s". Try list-backends.',
      [backendName]);
  args := Positionals(['--backend', '--db']);
  if Length(args) <> 1 then
    raise EMagicError.Create('Usage: reorganize --backend X <library-dir>');
  dir := args[0];
  if not DirectoryExists(dir) then
    raise EMagicError.CreateFmt('Directory "%s" not found.', [dir]);
  dryRun := HasFlag('--dry-run');

  index := TMagicIndex.Create(ResolveDbPath);
  hosts := TStringList.Create;
  loose := TStringList.Create;
  ctx := Default(TMagicContext);
  ctx.log := gLog;
  ctx.index := index;
  backend := backendClass.Create(ctx);
  try
    if not backend.ImportsByPath then
      raise EMagicError.CreateFmt('Backend "%s" organizes by name, not by a '
        + 'per-item folder; reorganize supports path-based backends (itchio).',
        [backendName]);

    { Group indexed items by host, the first segment of ItemSubdir. Objects[]
      holds the sole item's index + 1, or 0 once a second item shares the host. }
    hosts.Sorted := true;
    hosts.Duplicates := dupIgnore;
    FillChar(f, SizeOf(f), 0);
    f.backend := backendName;
    items := index.ListItems(f);
    for i := 0 to High(items) do begin
      FillItem(i);
      rel := SanitizeSubdir(backend.ItemSubdir(citem));
      p := Pos('/', rel);
      if p <= 1 then
        continue;  { needs a <host>/<slug> shape }
      host := Copy(rel, 1, p - 1);
      idx := hosts.IndexOf(host);
      if idx < 0 then
        hosts.AddObject(host, TObject(PtrInt(i + 1)))
      else
        hosts.Objects[idx] := TObject(PtrInt(0));  { host owns several items }
    end;

    foldered := 0;
    filesMoved := 0;
    multiHosts := 0;
    skippedFiles := 0;
    for idx := 0 to hosts.Count - 1 do begin
      i := PtrInt(hosts.Objects[idx]) - 1;
      host := hosts[idx];
      hostDir := IncludeTrailingPathDelimiter(dir) + host;
      if i < 0 then begin
        { Several owned items: Tier B (hash matching), not handled here. Count
          it only when loose files actually sit under the host on disk. }
        if DirectoryExists(hostDir) and (CountLooseFiles(hostDir) > 0) then
          Inc(multiHosts);
        continue;
      end;
      if not DirectoryExists(hostDir) then
        continue;
      FillItem(i);
      rel := SanitizeSubdir(backend.ItemSubdir(citem));
      targetDir := IncludeTrailingPathDelimiter(dir) + rel;

      { Collect the loose files first, then move, so renaming does not disturb
        the directory scan. }
      loose.Clear;
      if FindFirst(IncludeTrailingPathDelimiter(hostDir) + '*', faAnyFile,
        rec) = 0 then
      try
        repeat
          if (rec.Attr and faDirectory) = 0 then
            loose.Add(rec.Name);
        until FindNext(rec) <> 0;
      finally
        FindClose(rec);
      end;

      movedHere := 0;
      for k := 0 to loose.Count - 1 do begin
        srcFile := IncludeTrailingPathDelimiter(hostDir) + loose[k];
        dstFile := IncludeTrailingPathDelimiter(targetDir) + loose[k];
        if FileExists(dstFile) then begin
          gLog.Info(Format('  skip (exists): %s', [dstFile]));
          Inc(skippedFiles);
          continue;
        end;
        if dryRun then
          gLog.Info(Format('  move: %s -> %s', [srcFile, dstFile]))
        else begin
          if not DirectoryExists(targetDir) then
            if not ForceDirectories(targetDir) then
              raise EMagicError.CreateFmt('Cannot create folder: %s',
                [targetDir]);
          if not RenameFile(srcFile, dstFile) then
            raise EMagicError.CreateFmt('Cannot move %s', [srcFile]);
        end;
        Inc(filesMoved);
        Inc(movedHere);
      end;
      if movedHere > 0 then
        Inc(foldered);
    end;

    if dryRun then
      gLog.Info(Format('Would fold %d file(s) into %d host(s); %d host(s) with '
        + 'several owned items skipped.', [filesMoved, foldered, multiHosts]))
    else
      gLog.Info(Format('Folded %d file(s) into %d host(s); %d host(s) with '
        + 'several owned items skipped.', [filesMoved, foldered, multiHosts]));
    if skippedFiles > 0 then
      gLog.Info(Format('%d file(s) left in place (a file of that name already '
        + 'existed in the target).', [skippedFiles]));
  finally
    backend.Free;
    loose.Free;
    hosts.Free;
    index.Free;
  end;
end;

procedure CmdImport;
var
  backendClass: TMagicBackendClass;
  backend: TMagicBackend;
  ctx: TMagicContext;
  backendName, dir, artistPath, albumTitle, key, rel, full: string;
  args: TStringArray;
  index: TMagicIndex;
  items: TIndexedItemArray;
  keys: TStringList;
  f: TItemFilter;
  citem: TCollectionItem;
  artistRec, albumRec: TSearchRec;
  i, idx, matched, unmatched: LongInt;
  dryRun: boolean;
begin
  backendName := ArgValue('--backend', '');
  backendClass := FindBackend(backendName);
  if backendClass = nil then
    raise EMagicError.CreateFmt('Unknown backend: "%s". Try list-backends.',
      [backendName]);
  args := Positionals(['--backend', '--db']);
  if Length(args) <> 1 then
    raise EMagicError.Create('Usage: import --backend X <library-dir>');
  dir := args[0];
  if not DirectoryExists(dir) then
    raise EMagicError.CreateFmt('Directory "%s" not found.', [dir]);
  dryRun := HasFlag('--dry-run');

  index := TMagicIndex.Create(ResolveDbPath);
  keys := TStringList.Create;
  ctx := Default(TMagicContext);
  ctx.log := gLog;
  ctx.index := index;
  backend := backendClass.Create(ctx);
  try
    FillChar(f, SizeOf(f), 0);
    f.backend := backendName;
    items := index.ListItems(f);
    matched := 0;
    unmatched := 0;

    if backend.ImportsByPath then begin
      { Direct lookup: each item's own download path under the library. }
      for i := 0 to High(items) do begin
        citem := Default(TCollectionItem);
        citem.id := items[i].backendId;
        citem.title := items[i].title;
        citem.artist := items[i].creator;
        citem.pageUrl := items[i].pageUrl;
        rel := SanitizeSubdir(backend.ItemSubdir(citem));
        if rel = '' then begin
          Inc(unmatched);
          continue;
        end;
        full := IncludeTrailingPathDelimiter(dir) + rel;
        if DirectoryExists(full) then begin
          Inc(matched);
          if dryRun then
            gLog.Info(Format('  match: %s  [%s] -> %s',
              [ItemDisplayName(citem), items[i].backendId, full]))
          else
            index.SetImported(backendName, items[i].backendId, full);
        end
        else begin
          Inc(unmatched);
          gLog.Debug(Format('  no local folder: %s', [rel]));
        end;
      end;
    end
    else begin
      { Name walk: Artist folders, then album folders, keyed by creator/title. }
      keys.Sorted := true;
      keys.Duplicates := dupIgnore;
      for i := 0 to High(items) do
        keys.AddObject(
          SanitizeName(items[i].creator) + '/' + SanitizeName(items[i].title),
          TObject(PtrInt(i)));

      if FindFirst(IncludeTrailingPathDelimiter(dir) + '*', faDirectory,
        artistRec) = 0 then
      try
        repeat
          if (artistRec.Name = '.') or (artistRec.Name = '..')
            or ((artistRec.Attr and faDirectory) = 0) then
            continue;
          artistPath := IncludeTrailingPathDelimiter(dir) + artistRec.Name;
          if FindFirst(IncludeTrailingPathDelimiter(artistPath) + '*',
            faDirectory, albumRec) = 0 then
          try
            repeat
              if (albumRec.Name = '.') or (albumRec.Name = '..')
                or ((albumRec.Attr and faDirectory) = 0) then
                continue;
              albumTitle := StripYearPrefix(albumRec.Name);
              key := artistRec.Name + '/' + albumTitle;
              idx := keys.IndexOf(key);
              if idx < 0 then  { try the folder name unstripped }
                idx := keys.IndexOf(artistRec.Name + '/' + albumRec.Name);
              if idx >= 0 then begin
                i := PtrInt(keys.Objects[idx]);
                Inc(matched);
                if dryRun then
                  gLog.Info(Format('  match: %s - %s  [%s]',
                    [items[i].creator, items[i].title, items[i].backendId]))
                else
                  index.SetImported(backendName, items[i].backendId,
                    IncludeTrailingPathDelimiter(artistPath) + albumRec.Name);
              end
              else begin
                Inc(unmatched);
                gLog.Debug(Format('  no match: %s/%s',
                  [artistRec.Name, albumRec.Name]));
              end;
            until FindNext(albumRec) <> 0;
          finally
            FindClose(albumRec);
          end;
        until FindNext(artistRec) <> 0;
      finally
        FindClose(artistRec);
      end;
    end;

    if not dryRun then
      index.Commit;
    if dryRun then
      gLog.Info(Format('Would import %d item(s); %d with no match.',
        [matched, unmatched]))
    else
      gLog.Info(Format('Imported %d item(s); %d with no match.',
        [matched, unmatched]));
  finally
    backend.Free;
    keys.Free;
    index.Free;
  end;
end;

{** Escapes the five characters that are special in HTML text and attributes. }
function HtmlEscape(const s: string): string;
begin
  Result := StringReplace(s, '&', '&amp;', [rfReplaceAll]);
  Result := StringReplace(Result, '<', '&lt;', [rfReplaceAll]);
  Result := StringReplace(Result, '>', '&gt;', [rfReplaceAll]);
  Result := StringReplace(Result, '"', '&quot;', [rfReplaceAll]);
end;

{** Escapes the characters that would break a Markdown link label: the brackets
  themselves, a backtick (code span), and a less-than (an HTML tag). The
  backslash is escaped first so it does not double-escape the others. }
function MdEscape(const s: string): string;
begin
  Result := StringReplace(s, '\', '\\', [rfReplaceAll]);
  Result := StringReplace(Result, '[', '\[', [rfReplaceAll]);
  Result := StringReplace(Result, ']', '\]', [rfReplaceAll]);
  Result := StringReplace(Result, '`', '\`', [rfReplaceAll]);
  Result := StringReplace(Result, '<', '\<', [rfReplaceAll]);
end;

{** Display name for an indexed item: "creator - title", with fallbacks. }
function IndexedItemName(const it: TIndexedItem): string;
begin
  if (it.creator <> '') and (it.title <> '') then
    Result := it.creator + ' - ' + it.title
  else if it.title <> '' then
    Result := it.title
  else if it.creator <> '' then
    Result := it.creator
  else
    Result := '(no title)';
end;

{** Writes a browsable library manifest, one section per backend, from the
  index. Markdown by default, or HTML with --html (or an .html --out-file).
  Each item carries a checkbox reflecting the index's recorded download state,
  so run `verify` first for an accurate picture; --no-check lists items with no
  checkbox and no download tally. The list filters (--backend, --status,
  --hidden, --limit, ...) scope the manifest. Output goes to stdout, or to the
  path given by --out-file. }
procedure CmdManifest;
var
  index: TMagicIndex;
  f: TItemFilter;
  backends: TStringArray;
  items: TIndexedItemArray;
  lines: TStringList;
  outFile, name, box, line: string;
  html, noCheck: boolean;
  b, i, total, done: LongInt;

  procedure Emit(const s: string);
  begin
    lines.Add(s);
  end;

begin
  f := ParseItemFilter;
  outFile := ArgValue('--out-file', '');
  noCheck := HasFlag('--no-check');
  html := HasFlag('--html');
  if (not html) and (outFile <> '') then
    html := SameText(ExtractFileExt(outFile), '.html')
      or SameText(ExtractFileExt(outFile), '.htm');

  index := TMagicIndex.Create(ResolveDbPath);
  lines := TStringList.Create;
  try
    if f.backend <> '' then begin
      SetLength(backends, 1);
      backends[0] := f.backend;
    end
    else
      backends := index.Backends;

    total := 0;
    done := 0;

    if html then begin
      Emit('<!doctype html>');
      Emit('<html lang="en">');
      Emit('<head>');
      Emit('<meta charset="utf-8">');
      Emit('<meta name="viewport" content="width=device-width, initial-scale=1">');
      Emit('<title>magicdl library manifest</title>');
      Emit('<style>');
      Emit('body{font-family:system-ui,sans-serif;max-width:50rem;' +
        'margin:2rem auto;padding:0 1rem;line-height:1.5}');
      Emit('h2{border-bottom:1px solid #ccc;padding-bottom:.2rem;margin-top:2rem}');
      Emit('ul{list-style:none;padding-left:0}');
      Emit('li{padding:.1rem 0}');
      Emit('input{margin-right:.5rem}');
      Emit('.id{color:#888;font-size:.85em;margin-left:.4rem}');
      Emit('</style>');
      Emit('</head>');
      Emit('<body>');
      Emit('<h1>Library manifest</h1>');
    end
    else
      Emit('# Library manifest');

    for b := 0 to High(backends) do begin
      f.backend := backends[b];
      items := index.ListItems(f);
      if Length(items) = 0 then
        continue;

      if html then begin
        Emit('<h2>' + HtmlEscape(backends[b]) + '</h2>');
        Emit('<ul>');
      end
      else begin
        Emit('');
        Emit('## ' + backends[b]);
        Emit('');
      end;

      for i := 0 to High(items) do begin
        Inc(total);
        if items[i].downloaded then
          Inc(done);
        name := IndexedItemName(items[i]);

        if html then begin
          line := '<li>';
          if not noCheck then
            if items[i].downloaded then
              line := line + '<input type="checkbox" checked disabled>'
            else
              line := line + '<input type="checkbox" disabled>';
          if items[i].pageUrl <> '' then
            line := line + '<a href="' + HtmlEscape(items[i].pageUrl) + '">' +
              HtmlEscape(name) + '</a>'
          else
            line := line + HtmlEscape(name);
          line := line + '<span class="id">' + HtmlEscape(items[i].backendId) +
            '</span></li>';
        end
        else begin
          if noCheck then
            box := '- '
          else if items[i].downloaded then
            box := '- [x] '
          else
            box := '- [ ] ';
          if items[i].pageUrl <> '' then
            line := box + '[' + MdEscape(name) + '](' + items[i].pageUrl + ')'
          else
            line := box + MdEscape(name);
          line := line + ' `' + items[i].backendId + '`';
        end;
        Emit(line);
      end;

      if html then
        Emit('</ul>');
    end;

    if html then begin
      if noCheck then
        Emit(Format('<p>%d item(s).</p>', [total]))
      else
        Emit(Format('<p>%d of %d item(s) downloaded.</p>', [done, total]));
      Emit('</body>');
      Emit('</html>');
    end
    else begin
      Emit('');
      if noCheck then
        Emit(Format('%d item(s).', [total]))
      else
        Emit(Format('%d of %d item(s) downloaded.', [done, total]));
    end;

    if outFile <> '' then begin
      outFile := ExpandPathVars(outFile);
      lines.SaveToFile(outFile);
      gLog.Info(Format('Wrote %d item(s) to %s.', [total, outFile]));
    end
    else
      Write(lines.Text);
  finally
    lines.Free;
    index.Free;
  end;
end;

{** Reads a secret from standard input without echoing it to the terminal. The
  prompt goes to standard error so `key get` style piping is not disturbed. When
  input is not a terminal (a pipe), the line is read as-is. Trailing and leading
  whitespace are trimmed, matching ReadKeyFile. }
function PromptSecret(const prompt: string): string;
{$IFDEF UNIX}
var
  oldState, noEcho: TTermios;
  haveTty: boolean;
{$ENDIF}
begin
  Write(StdErr, prompt);
  Flush(StdErr);
  {$IFDEF UNIX}
  haveTty := TCGetAttr(StdInputHandle, oldState) = 0;
  if haveTty then begin
    noEcho := oldState;
    noEcho.c_lflag := noEcho.c_lflag and (not ECHO);
    TCSetAttr(StdInputHandle, TCSANOW, noEcho);
  end;
  ReadLn(Result);
  if haveTty then begin
    TCSetAttr(StdInputHandle, TCSANOW, oldState);
    Writeln(StdErr);  { the newline the suppressed Enter did not print }
  end;
  {$ELSE}
  ReadLn(Result);
  {$ENDIF}
  Result := Trim(Result);
end;

{** Stores, shows, or removes a backend's key in the system keyring. The action
  is the first positional word (set/get/rm), --backend names the backend, and
  an optional --user keeps several accounts of one backend apart. }
procedure CmdKey;
var
  action, backendName, user, account, label_, value: string;
begin
  action := '';
  if ParamCount >= 2 then
    action := ParamStr(2);
  if (action <> 'set') and (action <> 'get') and (action <> 'rm') then
    raise EMagicError.Create(
      'Usage: key set|get|rm --backend <name> [--user <account>]');
  RequireBackend(backendName);  { validates --backend }
  if not KeyringAvailable then
    raise EMagicError.Create('No system keyring is available (' +
      KeyringLastError + '). Use --app-key-file instead.');

  user := ArgValue('--user', '');
  account := KeyringAccount(backendName, user);
  { What to call this account in messages. }
  if user <> '' then
    label_ := backendName + ' (' + user + ')'
  else
    label_ := backendName;

  if action = 'set' then begin
    value := PromptSecret('Key for ' + label_ + ': ');
    if value = '' then
      raise EMagicError.Create('No key entered; nothing was stored.');
    if not KeyringStore(account, value) then
      raise EMagicError.Create('Could not store the key: ' + KeyringLastError + '.');
    gLog.Info('Stored the ' + label_ + ' key in the keyring.');
  end
  else if action = 'get' then begin
    if KeyringLookup(account, value) then
      Writeln(value)
    else if KeyringLastError <> '' then
      raise EMagicError.Create('Keyring error: ' + KeyringLastError + '.')
    else
      raise EMagicError.CreateFmt('No key is stored for %s.', [label_]);
  end
  else begin  { rm }
    if KeyringClear(account) then
      gLog.Info('Removed the ' + label_ + ' key from the keyring.')
    else if KeyringLastError <> '' then
      raise EMagicError.Create('Could not remove the key: ' + KeyringLastError + '.')
    else
      gLog.Info('No key was stored for ' + label_ + '; nothing to remove.');
  end;
end;

{ ---- Main ---- }

var
  command: string;
begin
  Randomize;
  if HasFlag('--verbose') then
    gLog := TMagicLogger.Create(llDebug)
  else
    gLog := TMagicLogger.Create(llInfo);
  gConfig := TMagicConfig.Create;
  try
    command := '';
    if ParamCount >= 1 then
      command := ParamStr(1);

    try
      case command of
        'list-backends': CmdListBackends;
        'scopes': CmdScopes;
        'index': CmdIndex;
        'sync': CmdSync;
        'check': CmdCheck;
        'verify': CmdVerify;
        'status': CmdStatus;
        'list': CmdList;
        'details': CmdDetails;
        'relocate': CmdRelocate;
        'forget': CmdForget;
        'reorganize': CmdReorganize;
        'import': CmdImport;
        'manifest': CmdManifest;
        'blacklist': CmdBlacklist;
        'allow': CmdAllow;
        'key': CmdKey;
        '', '-h', '--help', 'help':
          PrintUsage;
        else begin
          gLog.Error(Format('Unknown command: "%s"', [command]));
          PrintUsage;
          ExitCode := 2;
        end;
      end;
    except
      on e: EMagicError do begin
        gLog.Error(e.Message);
        ExitCode := 1;
      end;
      on e: Exception do begin
        gLog.Error(Format('%s: %s', [e.ClassName, e.Message]));
        ExitCode := 1;
      end;
    end;
  finally
    gConfig.Free;
    gLog.Free;
  end;
end.
